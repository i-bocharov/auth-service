# ============================================
# SERVER CONFIGURATION
# ============================================
PORT=3001
NODE_ENV=development

# ============================================
# BACKEND CONFIGURATION
# ============================================
BACKEND_URL=http://localhost:3000

# ============================================
# ALLOWED REDIRECT URIS
# ============================================
# Список разрешённых redirect_uri через запятую
ALLOWED_REDIRECT_URIS=http://localhost:3000/auth/callback

# ============================================
# YANDEX OAUTH CONFIGURATION
# ============================================
# Get your credentials at: https://oauth.yandex.ru/
YANDEX_CLIENT_ID=your_yandex_client_id_here
YANDEX_CLIENT_SECRET=your_yandex_client_secret_here